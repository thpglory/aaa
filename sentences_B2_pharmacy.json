[
    {
        "id": 1354,
        "content_en": "I'd appreciate consultation regarding optimal therapeutic dosing.",
        "content_vi": "Tôi sẽ đánh giá cao tư vấn về liều dùng điều trị tối ưu.",
        "phonetic": "aɪd əˈpriʃiˌeɪt ˌkɑnsəlˈteɪʃən rɪˈɡɑrdɪŋ ˈɑptəməl ˌθɛrəˈpjutɪk ˈdoʊsɪŋ",
        "level_id": "B2",
