[
  {
    "id": 20201,
    "title": "Pharmacy Conversation 1",
    "title_vi": "Hội thoại nhà thuốc 1",
    "dialogue": [
      {
        "speaker": "A",
        "text_en": "Hello! How are you?",
        "text_vi": "Xin chào! Bạn khỏe không?"
      },
      {
        "speaker": "B",
        "text_en": "I am fine, thank you. And you?",
        "text_vi": "Tôi khỏe, cảm ơn. Còn bạn?"
      },
      {
        "speaker": "A",
        "text_en": "I am good. I like pharmacy.",
        "text_vi": "Tôi khỏe. Tôi thích nhà thuốc."
      },
      {
        "speaker": "B",
        "text_en": "Me too. It is nice.",
        "text_vi": "Tôi cũng vậy. Nó tuyệt."
      },
      {
        "speaker": "A",
        "text_en": "Thank you!",
        "text_vi": "Cảm ơn!"
      }
    ],
    "level_id": "A1",
    "topic_ids": [
      "pharmacy"
    ],
