[
  {
    "id": 20561,
    "title": "Housing Conversation 1",
    "title_vi": "Hội thoại nhà ở 1",
    "dialogue": [
      {
        "speaker": "A",
        "text_en": "Hello! How are you?",
        "text_vi": "Xin chào! Bạn khỏe không?"
      },
      {
        "speaker": "B",
        "text_en": "I am fine, thank you. And you?",
        "text_vi": "Tôi khỏe, cảm ơn. Còn bạn?"
      },
      {
        "speaker": "A",
        "text_en": "I am good. I like housing.",
        "text_vi": "Tôi khỏe. Tôi thích nhà ở."
      },
      {
        "speaker": "B",
        "text_en": "Me too. It is nice.",
        "text_vi": "Tôi cũng vậy. Nó tuyệt."
      },
      {
        "speaker": "A",
        "text_en": "Thank you!",
        "text_vi": "Cảm ơn!"
      }
    ],
    "level_id": "A1",
    "topic_ids": [
      "housing"
    ],
